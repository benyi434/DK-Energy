#include <16F887.h>
#device ADC=10
#fuses INTRC_IO, NOWDT, NOPROTECT, NOLVP, NOBROWNOUT, PUT
#use delay(clock=4000000)

#use fast_io(A)
#use fast_io(B)
#use fast_io(C)
#use fast_io(D)

// LCD 16x2
#define LCD_ENABLE_PIN  PIN_D0
#define LCD_RS_PIN      PIN_D1
#define LCD_RW_PIN      PIN_D2
#define LCD_DATA4       PIN_D4
#define LCD_DATA5       PIN_D5
#define LCD_DATA6       PIN_D6
#define LCD_DATA7       PIN_D7

#include <lcd.c>

// Entradas y salida
#define LED_VERDE      PIN_C0
#define BTN_MENU       PIN_C1
#define BTN_TELEFONO   PIN_C2

// Tiempos
#define APAGADO_MS     20000
#define REBOTE         25
#define TIEMPO_ANIM    250

void main()
{
   set_tris_a(0b00000011);
   set_tris_b(0b11111111);
   set_tris_c(0b11111110);
   set_tris_d(0b00000000);

   output_low(LED_VERDE);

   // Configuracion del ADC
   setup_adc_ports(sAN0 | sAN1 | VSS_VDD);
   setup_adc(ADC_CLOCK_DIV_32);
   set_adc_channel(0);
   delay_us(20);

   lcd_init();

   // Variables del sistema
   long adc_bateria=0, adc_solar=0;
   long inactividad=0;
   int porcentaje=0, tensionbat=30, tensionsol=0;
   int menu=0, reb1=0, reb2=0;
   int animacion=0, tiempoanim=0;

   short pantalla=1, cargando=0;
   short canal_bateria=1;
   short botonmenu=1, botontelefono=1;
   short Even1=0, Even2=0;
   short redibujar=1;

   int porcent_anterior=255;
   int tensionbat_anterior=255;
   int tensionsol_anterior=255;

   while(TRUE)
   {
      // Lee los dos potenciometros alternadamente
      if(canal_bateria==1)
      {
         adc_bateria=read_adc();
         set_adc_channel(1);
         delay_us(20);
         canal_bateria=0;
      }
      else
      {
         adc_solar=read_adc();
         set_adc_channel(0);
         delay_us(20);
         canal_bateria=1;
      }

      // Calcula los valores de la bateria y el panel solar
      porcentaje=((int32)adc_bateria*100)/1023;
      tensionbat=30+(((int32)adc_bateria*12)/1023);
      tensionsol=((int32)adc_solar*50)/1023;

      // Boton de menu y para prender la pantalla
      if(input_state(BTN_MENU)==0)
      {
         if(reb1<REBOTE)reb1++;
         if(reb1==REBOTE && botonmenu==1)
         {
            Even1=1;
            botonmenu=0;
         }
      }
      else
      {
         reb1=0;
         botonmenu=1;
      }

      // Boton para conectar o desconectar el telefono
      if(input_state(BTN_TELEFONO)==0)
      {
         if(reb2<REBOTE)reb2++;
         if(reb2==REBOTE && botontelefono==1)
         {
            Even2=1;
            botontelefono=0;
         }
      }
      else
      {
         reb2=0;
         botontelefono=1;
      }

      // Cambia el menu o prende la pantalla
      if(Even1==1)
      {
         inactividad=0;

         if(pantalla==0)
         {
            pantalla=1;
            menu=0;
         }
         else
         {
            menu++;
            if(menu>3)menu=0;
         }

         redibujar=1;
         Even1=0;
      }

      // Cambia el estado del telefono
      if(Even2==1)
      {
         inactividad=0;
         cargando=!cargando;
         pantalla=1;
         menu=1;
         animacion=0;
         tiempoanim=0;
         redibujar=1;
         Even2=0;
      }

      // Muestra el menu actual
      if(redibujar==1)
      {
         lcd_putc('\f');

         switch(menu)
         {
            case 0:
               printf(lcd_putc,"   DK ENERGY");
               printf(lcd_putc,"\n  POWER BANK");
               break;

            case 1:
               printf(lcd_putc,"BATERIA PB: %u%%",porcentaje);
               if(cargando==1)
                  printf(lcd_putc,"\nCARGANDO");
               else
                  printf(lcd_putc,"\nEN ESPERA");
               break;

            case 2:
               printf(lcd_putc,"ESTADO BATERIA");
               printf(lcd_putc,"\nTENSION: %u.%uV",
                      tensionbat/10,tensionbat%10);
               break;

            case 3:
               printf(lcd_putc,"PANEL SOLAR");
               printf(lcd_putc,"\n%u.%uV %s",
                      tensionsol/10,tensionsol%10,
                      tensionsol>=35 ? "ACTIVA" : "BAJA");
               break;
         }

         porcent_anterior=porcentaje;
         tensionbat_anterior=tensionbat;
         tensionsol_anterior=tensionsol;
         redibujar=0;
      }

      // LED verde cuando el telefono esta cargando
      if(cargando==1)
         output_high(LED_VERDE);
      else
         output_low(LED_VERDE);

      // Animacion de carga
      if(cargando==1)
      {
         tiempoanim++;

         if(tiempoanim>=TIEMPO_ANIM)
         {
            tiempoanim=0;
            animacion++;

            if(animacion>3)animacion=0;

            if(pantalla==1 && menu==1)
            {
               lcd_gotoxy(1,2);

               if(animacion==0)
                  printf(lcd_putc,"CARGANDO        ");
               if(animacion==1)
                  printf(lcd_putc,"CARGANDO.       ");
               if(animacion==2)
                  printf(lcd_putc,"CARGANDO..      ");
               if(animacion==3)
                  printf(lcd_putc,"CARGANDO...     ");
            }
         }
      }
      else
      {
         tiempoanim=0;
         animacion=0;
      }

      // Actualiza los datos que cambiaron
      if(pantalla==1 && menu==1 &&
         porcentaje!=porcent_anterior)
      {
         lcd_gotoxy(1,1);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,1);
         printf(lcd_putc,"BATERIA PB: %u%%",porcentaje);

         porcent_anterior=porcentaje;
      }

      if(pantalla==1 && menu==2 &&
         tensionbat!=tensionbat_anterior)
      {
         lcd_gotoxy(1,2);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,2);
         printf(lcd_putc,"TENSION: %u.%uV",
                tensionbat/10,tensionbat%10);

         tensionbat_anterior=tensionbat;
      }

      if(pantalla==1 && menu==3 &&
         tensionsol!=tensionsol_anterior)
      {
         lcd_gotoxy(1,2);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,2);
         printf(lcd_putc,"%u.%uV %s",
                tensionsol/10,tensionsol%10,
                tensionsol>=35 ? "ACTIVA" : "BAJA");

         tensionsol_anterior=tensionsol;
      }

      // Apagado automatico despues de 20 segundos
      if(pantalla==1)
      {
         if(inactividad<APAGADO_MS)inactividad++;

         if(inactividad>=APAGADO_MS)
         {
            pantalla=0;
            lcd_putc('\f');
         }
      }

      delay_ms(1);
   }
}
