....................  
.................... #ifndef __LCD_C__ 
.................... #define __LCD_C__ 
....................  
.................... // define the pinout. 
.................... // only required if port access is being used. 
.................... typedef struct   
.................... {                            // This structure is overlayed 
....................    int1 enable;           // on to an I/O port to gain 
....................    int1 rs;               // access to the LCD pins. 
....................    int1 rw;               // The bits are allocated from 
....................    int1 unused;           // low order up.  ENABLE will 
....................    unsigned int     data : 4;         // be LSB pin of that port. 
....................   #if defined(__PCD__)       // The port used will be LCD_DATA_PORT. 
....................    unsigned int    reserved: 8; 
....................   #endif 
.................... } LCD_PIN_MAP; 
....................  
.................... // this is to improve compatability with previous LCD drivers that accepted 
.................... // a define labeled 'use_portb_lcd' that configured the LCD onto port B. 
.................... #if ((defined(use_portb_lcd)) && (use_portb_lcd==TRUE)) 
....................  #define LCD_DATA_PORT getenv("SFR:PORTB") 
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    // these definitions only need to be modified for baseline PICs. 
....................    // all other PICs use LCD_PIN_MAP or individual LCD_xxx pin definitions. 
.................... /*                                    EN, RS,   RW,   UNUSED,  DATA  */ 
....................  const LCD_PIN_MAP LCD_OUTPUT_MAP =  {0,  0,    0,    0,       0}; 
....................  const LCD_PIN_MAP LCD_INPUT_MAP =   {0,  0,    0,    0,       0xF}; 
.................... #endif 
....................  
.................... ////////////////////// END CONFIGURATION /////////////////////////////////// 
....................  
.................... #ifndef LCD_ENABLE_PIN 
....................    #define lcd_output_enable(x) lcdlat.enable=x 
....................    #define lcd_enable_tris()   lcdtris.enable=0 
.................... #else 
....................    #define lcd_output_enable(x) output_bit(LCD_ENABLE_PIN, x) 
....................    #define lcd_enable_tris()  output_drive(LCD_ENABLE_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RS_PIN 
....................    #define lcd_output_rs(x) lcdlat.rs=x 
....................    #define lcd_rs_tris()   lcdtris.rs=0 
.................... #else 
....................    #define lcd_output_rs(x) output_bit(LCD_RS_PIN, x) 
....................    #define lcd_rs_tris()  output_drive(LCD_RS_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RW_PIN 
....................    #define lcd_output_rw(x) lcdlat.rw=x 
....................    #define lcd_rw_tris()   lcdtris.rw=0 
.................... #else 
....................    #define lcd_output_rw(x) output_bit(LCD_RW_PIN, x) 
....................    #define lcd_rw_tris()  output_drive(LCD_RW_PIN) 
.................... #endif 
....................  
.................... // original version of this library incorrectly labeled LCD_DATA0 as LCD_DATA4, 
.................... // LCD_DATA1 as LCD_DATA5, and so on.  this block of code makes the driver 
.................... // compatible with any code written for the original library 
.................... #if (defined(LCD_DATA0) && defined(LCD_DATA1) && defined(LCD_DATA2) && defined(LCD_DATA3) && !defined(LCD_DATA4) && !defined(LCD_DATA5) && !defined(LCD_DATA6) && !defined(LCD_DATA7)) 
....................    #define  LCD_DATA4    LCD_DATA0 
....................    #define  LCD_DATA5    LCD_DATA1 
....................    #define  LCD_DATA6    LCD_DATA2 
....................    #define  LCD_DATA7    LCD_DATA3 
.................... #endif 
....................  
.................... #ifndef LCD_DATA4 
.................... #ifndef LCD_DATA_PORT 
....................    #if defined(__PCB__) 
....................       #define LCD_DATA_PORT      0x06     //portb 
....................       #define set_tris_lcd(x)   set_tris_b(x) 
....................    #else 
....................      #if defined(PIN_D0) 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTD")     //portd 
....................      #else 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTB")     //portb 
....................      #endif 
....................    #endif    
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    LCD_PIN_MAP lcd, lcdlat; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
.................... #elif defined(__PCM__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
....................    #byte lcdtris = LCD_DATA_PORT+0x80 
.................... #elif defined(__PCH__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT+9 
....................    #byte lcdtris = LCD_DATA_PORT+0x12 
.................... #elif defined(__PCD__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #word lcd = LCD_DATA_PORT 
....................    #word lcdlat = LCD_DATA_PORT+2 
....................    #word lcdtris = LCD_DATA_PORT-0x02 
.................... #endif 
.................... #endif   //LCD_DATA4 not defined 
....................  
.................... #ifndef LCD_TYPE 
....................    #define LCD_TYPE 2           // 0=5x7, 1=5x10, 2=2 lines 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_TWO 
....................    #define LCD_LINE_TWO 0x40    // LCD RAM address for the second line 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_LENGTH 
....................    #define LCD_LINE_LENGTH 20 
.................... #endif 
....................  
.................... unsigned int8 lcd_read_nibble(void); 
....................  
.................... unsigned int8 lcd_read_byte(void) 
.................... { 
....................    unsigned int8 low,high; 
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_INPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_float(LCD_DATA4); 
*
00C0:  BSF    03.5
00C1:  BSF    08.4
....................    output_float(LCD_DATA5); 
00C2:  BSF    08.5
....................    output_float(LCD_DATA6); 
00C3:  BSF    08.6
....................    output_float(LCD_DATA7); 
00C4:  BSF    08.7
....................   #else 
....................    lcdtris.data = 0xF; 
....................   #endif 
....................  #endif 
....................          
....................    lcd_output_rw(1); 
00C5:  BCF    03.5
00C6:  BSF    08.2
....................    delay_cycles(1); 
00C7:  NOP
....................    lcd_output_enable(1); 
00C8:  BSF    08.0
....................    delay_cycles(1); 
00C9:  NOP
....................    high = lcd_read_nibble(); 
00CA:  CALL   095
00CB:  MOVF   78,W
00CC:  MOVWF  52
....................        
....................    lcd_output_enable(0); 
00CD:  BCF    08.0
....................    delay_cycles(1); 
00CE:  NOP
....................    lcd_output_enable(1); 
00CF:  BSF    08.0
....................    delay_us(1); 
....................    low = lcd_read_nibble(); 
00D0:  CALL   095
00D1:  MOVF   78,W
00D2:  MOVWF  51
....................        
....................    lcd_output_enable(0); 
00D3:  BCF    08.0
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
00D4:  BSF    03.5
00D5:  BCF    08.4
....................    output_drive(LCD_DATA5); 
00D6:  BCF    08.5
....................    output_drive(LCD_DATA6); 
00D7:  BCF    08.6
....................    output_drive(LCD_DATA7); 
00D8:  BCF    08.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................  #endif 
....................  
....................    return( (high<<4) | low); 
00D9:  BCF    03.5
00DA:  SWAPF  52,W
00DB:  MOVWF  77
00DC:  MOVLW  F0
00DD:  ANDWF  77,F
00DE:  MOVF   77,W
00DF:  IORWF  51,W
00E0:  MOVWF  78
.................... } 
....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
*
0095:  CLRF   53
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
0096:  MOVLW  00
0097:  BTFSC  08.4
0098:  MOVLW  01
0099:  IORWF  53,F
....................    n |= input(LCD_DATA5) << 1; 
009A:  MOVLW  00
009B:  BTFSC  08.5
009C:  MOVLW  01
009D:  MOVWF  77
009E:  BCF    03.0
009F:  RLF    77,F
00A0:  MOVF   77,W
00A1:  IORWF  53,F
....................    n |= input(LCD_DATA6) << 2; 
00A2:  MOVLW  00
00A3:  BTFSC  08.6
00A4:  MOVLW  01
00A5:  MOVWF  77
00A6:  RLF    77,F
00A7:  RLF    77,F
00A8:  MOVLW  FC
00A9:  ANDWF  77,F
00AA:  MOVF   77,W
00AB:  IORWF  53,F
....................    n |= input(LCD_DATA7) << 3; 
00AC:  MOVLW  00
00AD:  BTFSC  08.7
00AE:  MOVLW  01
00AF:  MOVWF  77
00B0:  RLF    77,F
00B1:  RLF    77,F
00B2:  RLF    77,F
00B3:  MOVLW  F8
00B4:  ANDWF  77,F
00B5:  MOVF   77,W
00B6:  IORWF  53,F
....................     
....................    return(n); 
00B7:  MOVF   53,W
00B8:  MOVWF  78
....................   #else 
00B9:  RETURN
....................    return(lcd.data); 
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
*
007D:  BTFSC  52.0
007E:  GOTO   081
007F:  BCF    08.4
0080:  GOTO   082
0081:  BSF    08.4
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
0082:  BTFSC  52.1
0083:  GOTO   086
0084:  BCF    08.5
0085:  GOTO   087
0086:  BSF    08.5
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
0087:  BTFSC  52.2
0088:  GOTO   08B
0089:  BCF    08.6
008A:  GOTO   08C
008B:  BSF    08.6
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
008C:  BTFSC  52.3
008D:  GOTO   090
008E:  BCF    08.7
008F:  GOTO   091
0090:  BSF    08.7
....................   #else       
....................    lcdlat.data = n; 
....................   #endif 
....................        
....................    delay_cycles(1); 
0091:  NOP
....................    lcd_output_enable(1); 
0092:  BSF    08.0
....................    delay_us(2); 
....................    lcd_output_enable(0); 
0093:  BCF    08.0
0094:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
00BA:  BSF    03.5
00BB:  BCF    08.0
....................    lcd_rs_tris(); 
00BC:  BCF    08.1
....................    lcd_rw_tris(); 
00BD:  BCF    08.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
00BE:  BCF    03.5
00BF:  BCF    08.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
00E1:  MOVF   78,W
00E2:  MOVWF  51
00E3:  BTFSC  51.7
00E4:  GOTO   0C0
....................    lcd_output_rs(address); 
00E5:  MOVF   4F,F
00E6:  BTFSS  03.2
00E7:  GOTO   0EA
00E8:  BCF    08.1
00E9:  GOTO   0EB
00EA:  BSF    08.1
....................    delay_cycles(1); 
00EB:  NOP
....................    lcd_output_rw(0); 
00EC:  BCF    08.2
....................    delay_cycles(1); 
00ED:  NOP
....................    lcd_output_enable(0); 
00EE:  BCF    08.0
....................    lcd_send_nibble(n >> 4); 
00EF:  SWAPF  50,W
00F0:  MOVWF  51
00F1:  MOVLW  0F
00F2:  ANDWF  51,F
00F3:  MOVF   51,W
00F4:  MOVWF  52
00F5:  CALL   07D
....................    lcd_send_nibble(n & 0xf); 
00F6:  MOVF   50,W
00F7:  ANDLW  0F
00F8:  MOVWF  51
00F9:  MOVWF  52
00FA:  CALL   07D
00FB:  RETURN
.................... } 
....................  
.................... #if defined(LCD_EXTENDED_NEWLINE) 
.................... unsigned int8 g_LcdX, g_LcdY; 
.................... #endif 
....................  
.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
00FC:  MOVLW  28
00FD:  MOVWF  42
00FE:  MOVLW  0C
00FF:  MOVWF  43
0100:  MOVLW  01
0101:  MOVWF  44
0102:  MOVLW  06
0103:  MOVWF  45
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
0104:  BCF    08.0
....................    lcd_output_rs(0); 
0105:  BCF    08.1
....................    lcd_output_rw(0); 
0106:  BCF    08.2
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
0107:  BSF    03.5
0108:  BCF    08.4
....................    output_drive(LCD_DATA5); 
0109:  BCF    08.5
....................    output_drive(LCD_DATA6); 
010A:  BCF    08.6
....................    output_drive(LCD_DATA7); 
010B:  BCF    08.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................    lcd_enable_tris(); 
010C:  BCF    08.0
....................    lcd_rs_tris(); 
010D:  BCF    08.1
....................    lcd_rw_tris(); 
010E:  BCF    08.2
....................  #endif 
....................      
....................    delay_ms(15); 
010F:  MOVLW  27
0110:  MOVWF  77
0111:  DECFSZ 77,F
0112:  GOTO   111
0113:  GOTO   114
....................    for(i=1;i<=3;++i) 
0114:  MOVLW  01
0115:  BCF    03.5
0116:  MOVWF  41
0117:  MOVF   41,W
0118:  SUBLW  03
0119:  BTFSS  03.0
011A:  GOTO   124
....................    { 
....................        lcd_send_nibble(3); 
011B:  MOVLW  03
011C:  MOVWF  52
011D:  CALL   07D
....................        delay_ms(5); 
011E:  MOVLW  0D
011F:  MOVWF  77
0120:  DECFSZ 77,F
0121:  GOTO   120
0122:  INCF   41,F
0123:  GOTO   117
....................    } 
....................     
....................    lcd_send_nibble(2); 
0124:  MOVLW  02
0125:  MOVWF  52
0126:  CALL   07D
....................    delay_ms(5); 
0127:  MOVLW  0D
0128:  MOVWF  77
0129:  DECFSZ 77,F
012A:  GOTO   129
....................    for(i=0;i<=3;++i) 
012B:  CLRF   41
012C:  MOVF   41,W
012D:  SUBLW  03
012E:  BTFSS  03.0
012F:  GOTO   13C
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
0130:  MOVLW  42
0131:  ADDWF  41,W
0132:  MOVWF  04
0133:  BCF    03.7
0134:  MOVF   00,W
0135:  MOVWF  46
0136:  CLRF   4F
0137:  MOVF   46,W
0138:  MOVWF  50
0139:  CALL   0BA
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
013A:  INCF   41,F
013B:  GOTO   12C
013C:  BCF    0A.3
013D:  BCF    0A.4
013E:  GOTO   389 (RETURN)
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
.................... } 
....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
01B8:  DECFSZ 4C,W
01B9:  GOTO   1BB
01BA:  GOTO   1BE
....................       address=LCD_LINE_TWO; 
01BB:  MOVLW  40
01BC:  MOVWF  4D
01BD:  GOTO   1BF
....................    else 
....................       address=0; 
01BE:  CLRF   4D
....................       
....................    address+=x-1; 
01BF:  MOVLW  01
01C0:  SUBWF  4B,W
01C1:  ADDWF  4D,F
....................    lcd_send_byte(0,0x80|address); 
01C2:  MOVF   4D,W
01C3:  IORLW  80
01C4:  MOVWF  4E
01C5:  CLRF   4F
01C6:  MOVF   4E,W
01C7:  MOVWF  50
01C8:  CALL   0BA
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
01C9:  RETURN
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
01CA:  MOVF   4A,W
01CB:  XORLW  07
01CC:  BTFSC  03.2
01CD:  GOTO   1D8
01CE:  XORLW  0B
01CF:  BTFSC  03.2
01D0:  GOTO   1DD
01D1:  XORLW  06
01D2:  BTFSC  03.2
01D3:  GOTO   1E6
01D4:  XORLW  02
01D5:  BTFSC  03.2
01D6:  GOTO   1EC
01D7:  GOTO   1F1
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
01D8:  MOVLW  01
01D9:  MOVWF  4B
01DA:  MOVWF  4C
01DB:  CALL   1B8
01DC:  GOTO   1F6
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
01DD:  CLRF   4F
01DE:  MOVLW  01
01DF:  MOVWF  50
01E0:  CALL   0BA
....................                      delay_ms(2); 
01E1:  MOVLW  05
01E2:  MOVWF  77
01E3:  DECFSZ 77,F
01E4:  GOTO   1E3
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
01E5:  GOTO   1F6
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
....................          break; 
....................      #else 
....................       case '\n'   : lcd_gotoxy(1,2);        break; 
01E6:  MOVLW  01
01E7:  MOVWF  4B
01E8:  MOVLW  02
01E9:  MOVWF  4C
01EA:  CALL   1B8
01EB:  GOTO   1F6
....................      #endif 
....................       
....................       case '\b'   : lcd_send_byte(0,0x10);  break; 
01EC:  CLRF   4F
01ED:  MOVLW  10
01EE:  MOVWF  50
01EF:  CALL   0BA
01F0:  GOTO   1F6
....................       
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       default     :  
....................          if (g_LcdX < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, c); 
....................             g_LcdX++; 
....................          } 
....................          break; 
....................      #else 
....................       default     : lcd_send_byte(1,c);     break; 
01F1:  MOVLW  01
01F2:  MOVWF  4F
01F3:  MOVF   4A,W
01F4:  MOVWF  50
01F5:  CALL   0BA
....................      #endif 
....................    } 
01F6:  RETURN
.................... } 
....................   
.................... char lcd_getc(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    char value; 
....................  
....................    lcd_gotoxy(x,y); 
....................    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low 
....................    lcd_output_rs(1); 
....................    value = lcd_read_byte(); 
....................    lcd_output_rs(0); 
....................     
....................    return(value); 
.................... } 
....................  
.................... // write a custom character to the ram 
.................... // which is 0-7 and specifies which character array we are modifying. 
.................... // ptr points to an array of 8 bytes, where each byte is the next row of 
.................... //    pixels.  only bits 0-4 are used.  the last row is the cursor row, and 
.................... //    usually you will want to leave this byte 0x00. 
.................... void lcd_set_cgram_char(unsigned int8 which, unsigned int8 *ptr) 
.................... { 
....................    unsigned int i; 
....................  
....................    which <<= 3; 
....................    which &= 0x38; 
....................  
....................    lcd_send_byte(0, 0x40 | which);  //set cgram address 
....................  
....................    for(i=0; i<8; i++) 
....................    { 
....................       lcd_send_byte(1, *ptr++); 
....................    } 
....................    
....................    #if defined(LCD_EXTENDED_NEWLINE) 
....................     lcd_gotoxy(g_LcdX+1, g_LcdY+1);  //set ddram address 
....................    #endif 
.................... } 
....................  
.................... void lcd_cursor_on(int1 on) 
.................... { 
....................    if (on) 
....................    { 
....................       lcd_send_byte(0,0x0F);           //turn LCD cursor ON 
....................    } 
....................    else 
....................    { 
....................       lcd_send_byte(0,0x0C);           //turn LCD cursor OFF 
....................    } 
.................... } 
....................  
.................... #endif 
