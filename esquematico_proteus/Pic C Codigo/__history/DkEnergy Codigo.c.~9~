#include <16F887.h>
#device ADC=10
#fuses LP, NOWDT, NOPROTECT, NOLVP, NOBROWNOUT, PUT
#use delay(clock=32768)

#use fast_io(A)
#use fast_io(B)
#use fast_io(C)
#use fast_io(D)

#define LCD_ENABLE_PIN  PIN_D0
#define LCD_RS_PIN      PIN_D1
#define LCD_RW_PIN      PIN_D2
#define LCD_DATA4       PIN_D4
#define LCD_DATA5       PIN_D5
#define LCD_DATA6       PIN_D6
#define LCD_DATA7       PIN_D7

#include <lcd.c>

void main()
{
   long adc_bateria=0, adc_solar=0;
   long inactividad=0;

   int porcentaje=0, tensionbat=30, tensionsol=0;
   int menu=0, reb1=0, reb2=0;
   int animacion=0, tiempoanim=0;

   int porcent_anterior=255;
   int tensionbat_anterior=255;
   int tensionsol_anterior=255;

   short pantalla=1, cargando=0;
   short canal_bateria=1;
   short botonmenu=1, botontelefono=1;
   short Even1=0, Even2=0;
   short redibujar=1;

   set_tris_a(0b00000011);
   set_tris_b(0b11111111);
   set_tris_c(0b11111110);
   set_tris_d(0b00000000);

   output_low(PIN_C0);

   setup_adc_ports(sAN0 | sAN1 | VSS_VDD);
   setup_adc(ADC_CLOCK_INTERNAL);
   set_adc_channel(0);

   lcd_init();

   while(TRUE)
   {
      // Lee los dos potenciometros
      if(canal_bateria==1)
      {
         adc_bateria=read_adc();
         set_adc_channel(1);
         canal_bateria=0;
      }
      else
      {
         adc_solar=read_adc();
         set_adc_channel(0);
         canal_bateria=1;
      }

      porcentaje=((int32)adc_bateria*100)/1023;
      tensionbat=30+(((int32)adc_bateria*12)/1023);
      tensionsol=((int32)adc_solar*50)/1023;

      // Boton de menu
      if(input(PIN_C1)==0)
      {
         if(reb1<3)reb1++;

         if(reb1>=3 && botonmenu==1)
         {
            Even1=1;
            botonmenu=0;
         }
      }
      else
      {
         reb1=0;
         botonmenu=1;
      }

      // Boton de telefono
      if(input(PIN_C2)==0)
      {
         if(reb2<3)reb2++;

         if(reb2>=3 && botontelefono==1)
         {
            Even2=1;
            botontelefono=0;
         }
      }
      else
      {
         reb2=0;
         botontelefono=1;
      }

      // Cambia el menu
      if(Even1==1)
      {
         inactividad=0;

         if(pantalla==0)
         {
            pantalla=1;
            menu=0;
         }
         else
         {
            menu++;
            if(menu>3)menu=0;
         }

         redibujar=1;
         Even1=0;
      }

      // Conecta o desconecta el telefono simulado
      if(Even2==1)
      {
         inactividad=0;
         cargando=!cargando;
         pantalla=1;
         menu=1;
         animacion=0;
         tiempoanim=0;
         redibujar=1;
         Even2=0;
      }

      // Muestra el menu
      if(redibujar==1)
      {
         lcd_putc('\f');

         switch(menu)
         {
            case 0:
               printf(lcd_putc,"   DK ENERGY");
               printf(lcd_putc,"\n  POWER BANK");
               break;

            case 1:
               printf(lcd_putc,"BATERIA PB: %u%%",porcentaje);

               if(cargando==1)
                  printf(lcd_putc,"\nCARGANDO");
               else
                  printf(lcd_putc,"\nEN ESPERA");
               break;

            case 2:
               printf(lcd_putc,"ESTADO BATERIA");
               printf(lcd_putc,"\nTENSION: %u.%uV",
                      tensionbat/10,tensionbat%10);
               break;

            case 3:
               printf(lcd_putc,"PANEL SOLAR");
               printf(lcd_putc,"\n%u.%uV %s",
                      tensionsol/10,tensionsol%10,
                      tensionsol>=35 ? "ACTIVA" : "BAJA");
               break;
         }

         porcent_anterior=porcentaje;
         tensionbat_anterior=tensionbat;
         tensionsol_anterior=tensionsol;
         redibujar=0;
      }

      // LED verde
      if(cargando==1)
         output_high(PIN_C0);
      else
         output_low(PIN_C0);

      // Animacion de carga
      if(cargando==1)
      {
         tiempoanim++;

         if(tiempoanim>=10)
         {
            tiempoanim=0;
            animacion++;

            if(animacion>3)animacion=0;

            if(pantalla==1 && menu==1)
            {
               lcd_gotoxy(1,2);

               switch(animacion)
               {
                  case 0:
                     printf(lcd_putc,"CARGANDO        ");
                     break;

                  case 1:
                     printf(lcd_putc,"CARGANDO.       ");
                     break;

                  case 2:
                     printf(lcd_putc,"CARGANDO..      ");
                     break;

                  case 3:
                     printf(lcd_putc,"CARGANDO...     ");
                     break;
               }
            }
         }
      }
      else
      {
         tiempoanim=0;
         animacion=0;
      }

      // Actualiza el porcentaje
      if(pantalla==1 && menu==1 &&
         porcentaje!=porcent_anterior)
      {
         lcd_gotoxy(1,1);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,1);
         printf(lcd_putc,"BATERIA PB: %u%%",porcentaje);

         porcent_anterior=porcentaje;
      }

      // Actualiza la tension de la bateria
      if(pantalla==1 && menu==2 &&
         tensionbat!=tensionbat_anterior)
      {
         lcd_gotoxy(1,2);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,2);
         printf(lcd_putc,"TENSION: %u.%uV",
                tensionbat/10,tensionbat%10);

         tensionbat_anterior=tensionbat;
      }

      // Actualiza la tension del panel solar
      if(pantalla==1 && menu==3 &&
         tensionsol!=tensionsol_anterior)
      {
         lcd_gotoxy(1,2);
         printf(lcd_putc,"                ");
         lcd_gotoxy(1,2);
         printf(lcd_putc,"%u.%uV %s",
                tensionsol/10,tensionsol%10,
                tensionsol>=35 ? "ACTIVA" : "BAJA");

         tensionsol_anterior=tensionsol;
      }

      // Apagado automatico
      if(pantalla==1)
      {
         if(inactividad<800)inactividad++;

         if(inactividad>=800)
         {
            pantalla=0;
            lcd_putc('\f');
         }
      }

      delay_ms(1);
   }
}
